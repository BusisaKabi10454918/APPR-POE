@page
@model APPR_POE_PART_1_prototype.Pages.DonateModel
@{
    ViewData["Title"] = "Donate";
}
<head>
    <link href="~/css/donation-style.css" rel="stylesheet">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon">

    <nav>
        <div class="logo">

            <a asp-page="/Index">
                <img src="~/images/GiftofTheGivers_logo.png" />
            </a>

        </div>
        <div class="nav-links">
            <a asp-page="/Index">Home</a>
            <a asp-page="/About">About Us</a>
            <a asp-page="/Volunteer">Volunteer</a>
            <a asp-page="/Donate">Donate</a>
            <a asp-page="/Contact">Contact Us</a>
        </div>
    </nav>
</head>
<body>
    <div class="container">
        <form method="post">

            <div class="currency-selection">
                <label class="currency-option">
                    <input type="radio" name="Currency" value="USD" asp-for="Currency" required />
                    <span>$</span>
                </label>

                <label class="currency-option">
                    <input type="radio" name="Currency" value="EUR" asp-for="Currency"/>
                    <span>€</span>
                </label>

                <label class="currency-option">
                    <input type="radio" name="Currency" value="ZAR" asp-for="Currency"/>
                    <span>R</span>
                </label>
            </div>

            <label for="donation-amount">Donation Amount:</label>
            <input class="donation-amount" asp-for="DonationAmount" id="DonationAmount" inputmode="decimal" name="DonationAmount" placeholder="Please donate within your means" min="1" required />

            <button type="submit" class="donate-button">Donate</button>

            <script src="~/js/page_validation.js"></script>
        </form>

        <div id="error-validation" class="validation-popup">
            <div class="popup-content">
                <p id="error-message"></p>
                <button type="button" id="error-close">OK</button>
            </div>
        </div>

        <div id="success-validation" class="validation-popup">
            <div class="popup-content">
                <p id="success-message"></p>
                <button type="button" id="success-close">OK</button>
            </div>
        </div>

    </div>   
</body>
@if (!string.IsNullOrEmpty(Model.validationResult))
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const message = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(Model.validationResult)
                            );

            const isSuccess = message.includes("VER-DON-0000:");

            showPopup(message, isSuccess);
        });
    </script>
}