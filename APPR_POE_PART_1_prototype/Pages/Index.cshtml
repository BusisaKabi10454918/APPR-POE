@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="css/styles.css" rel="stylesheet">
    <link href="/favicon.ico" rel="icon" type="image/x-icon">
</head>

<body>

    <nav>

        <div class="logo">
            <a asp-page="/Index">
                <img src="images/GiftofTheGivers_logo.png" />
            </a>
        </div>

        <div class="nav-links">
            <a id="homelink" asp-page="/Index">Home</a>
            <a id="aboutlink" asp-page="/About">About Us</a>
            <a id="volunteerlink" asp-page="/Volunteer">Volunteer</a>
            <a id="donatelink" asp-page="/Donate">Donate</a>
            <a id="contactlink" asp-page="/Contact">Contact Us</a>
        </div>

    </nav>

    <section class="page_banner">
        <img src="images/team_gift_background.png" />
    </section>

    <section class="page_content">

        <a asp-page="/Volunteer" class="feature-button">
            <img src="images/volunteer_button.png" alt="Become a volunteer">
        </a>

        <a asp-page="/Donate" class="feature-button">
            <img src="images/donate_button.png" alt="Register to donate">
        </a>

        <a asp-page="/About" class="feature-button">
            <img src="images/about_button.png" alt="Learn more about us">
        </a>

    </section>
</body>
</html>