@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}
<head>
    <link href="~/css/reg-login-styles.css" rel="stylesheet">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon">

    <nav>
        <div class="logo">

            <a asp-page="/Index">
                <img src="~/images/GiftofTheGivers_logo-1458481640.png" />
            </a>

        </div>
        <div class="nav-links">
            <a asp-page="/Index">Home</a>
            <a asp-page="/About">About Us</a>
            <a asp-page="/Login">Volunteer</a>
            <a asp-page="/Donate">Donate</a>
            <a asp-page="/Contact">Contact Us</a>
        </div>
    </nav>
</head>
<body class="reg-login-bodies">

    <section class="container">
        <form method="post">
            
            <label for="credential">Email or Username:</label><br />
            <input type="text" placeholder="Please enter your email or username" name="credential" /><br />

            <label for="password">Password:</label><br />
            <input type="password" placeholder="Please enter your password" name="password" /><br />
    
            <button type="submit">Login</button>

        </form>

        <p>Don't have an account? <a asp-page="/Register">Register here</a></p>
    </section>

    @{
        @if (Model.error_message != "Please enter matching passwords")
        {
            <p style="color: white">@Model.error_message</p>
        }
    }
</body>